{
  "name": "corporate-flight-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corporate flight booking self-booking tool \u2014 stages 1-4 (mock supply)",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/server/api/server.js",
    "build:web": "vite build",
    "dev:web": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node dist/server/store/seed.js",
    "typecheck": "tsc --noEmit",
    "start:dev": "tsx src/api/server.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "seed:dev": "tsx src/store/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
